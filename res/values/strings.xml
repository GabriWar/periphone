    <string name="st_cam_front">Streaming the front camera</string>
    <string name="st_cam_detail">%1$s · %2$.0f fps now · %3$d KB/s</string>
    <string name="st_cap_on">Sending the phone\'s sound to the PC</string>

    <!-- connection -->
    <string name="link_title">Connection</string>
    <string name="link_usb">USB</string>
    <string name="link_wifi">Wi-Fi</string>
    <string name="link_pan">BT net</string>
    <string name="link_bt">BT direct</string>
    <string name="link_usb_desc">Through the cable (adb). Lowest delay, nothing to set up here. On the PC: phone-bridge</string>
    <string name="link_wifi_desc">Same Wi-Fi as the PC, raw audio over UDP (a few ms more than USB). On the PC: phone-bridge --wifi</string>
    <string name="link_pan_desc">Bluetooth tethering: turn it on in Settings › Network › Hotspot &amp; tethering. Audio is compressed (Opus). On the PC: phone-bridge --pan</string>
    <string name="link_bt_desc">Straight to the paired PC over Bluetooth, no tethering. Audio is compressed (Opus); no camera (too little bandwidth). On the PC: phone-bridge --bt</string>
    <string name="pc_address">PC address</string>
    <string name="pc_address_hint">Empty = find it automatically</string>
    <string name="bt_pc">PC (paired device)</string>
    <string name="bt_none_paired">Nothing paired: pair the PC in the Bluetooth settings</string>
    <string name="pin">PIN (phone-bridge shows it on the PC)</string>
    <string name="pin_hint">6 digits</string>
    <string name="encrypt">Encrypt (AES-128-GCM)</string>
    <string name="codec">Audio codec</string>
    <string name="codec_auto">Automatic (raw on Wi-Fi, Opus on Bluetooth)</string>
    <string name="codec_pcm">Raw PCM (best quality, ~1.5 Mbit/s)</string>
    <string name="codec_opus">Opus 5 ms (light, ~160 kbit/s)</string>
    <string name="save_link">Save address and PIN</string>
    <string name="link_saved">Saved</string>
    <string name="link_where">Connected %1$s</string>
    <string name="via_wifi">over Wi-Fi to %1$s</string>
    <string name="via_pan">over Bluetooth tethering to %1$s</string>
    <string name="via_bt">over Bluetooth</string>

