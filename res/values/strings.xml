    <string name="unmute">Unmute</string>
    <string name="percent">%1$d%%</string>
    <string name="play_on">Play on</string>
    <string name="bt_tip">Bluetooth adds about 150–250 ms on its own. Wired headphones give the lowest delay.</string>

