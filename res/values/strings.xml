<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">USB Audio Bridge</string>
    <string name="tagline">PC audio, mic and camera over USB, Wi-Fi or Bluetooth</string>

    <!-- main status -->
    <string name="start">Start</string>
    <string name="stop">Stop</string>
    <string name="hero_stopped">Stopped</string>
    <string name="hero_stopped_hint">Run <b>phone-bridge</b> on the PC (add --wifi, --pan or --bt for wireless), or tap Start.</string>
    <string name="hero_waiting">Waiting for the PC…</string>
    <string name="hero_waiting_hint">Is <b>phone-bridge</b> running on the PC? It sets up the USB tunnel (adb reverse).</string>
    <string name="hero_waiting_net_hint">Is <b>phone-bridge --wifi</b> (or --pan / --bt) running on the PC, and is the PIN the one it shows?</string>
    <string name="hero_partial">Partially connected</string>
    <string name="hero_partial_hint">Some streams are still waiting for the PC. See below.</string>
    <string name="hero_connected">Connected to the PC</string>
    <string name="hero_connected_hint">Everything is flowing. You can turn the screen off.</string>
    <string name="hero_nothing">Nothing enabled</string>
    <string name="hero_nothing_hint">Turn on at least one of output, mic or camera below.</string>

