    <!-- phone sound -> PC -->
    <string name="cap_title">Phone audio → PC</string>
    <string name="cap_hint">Plays the phone\'s sound (music, videos, games) on the PC speakers. Android asks for screen-capture permission each session. Apps that block capture (calls, some DRM video) stay silent.</string>

