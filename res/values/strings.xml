    <string name="preset_balanced">Balanced</string>
    <string name="preset_stable">Stable</string>
    <string name="preset_lowest_desc">15 ms output / 10 ms mic. Best with wired headphones; may crackle on a busy phone.</string>
    <string name="preset_balanced_desc">30 ms output / 20 ms mic. A good default.</string>
    <string name="preset_stable_desc">80 ms output / 40 ms mic. Pick this if you hear dropouts.</string>
    <string name="preset_custom_desc">Custom: %1$d ms output / %2$d ms mic.</string>
