#!/usr/bin/env bash
# LEGACY alternative: sends the PC audio to the phone over the USB cable, played by
# the "Simple Protocol Player" app (F-Droid) instead of USB Audio Bridge.
# Prefer phone-bridge.
#
# On the phone, set the player up like this:
#   Host 127.0.0.1   Port 12345   Rate 48000   Channels 2   Format 16 bit
#
# Usage:  phone-speaker
# Ctrl-C puts the audio back on the previous output.
set -euo pipefail

PORT=12345
PREV=$(pactl get-default-sink 2>/dev/null || true)
PHONE=phone_speaker

if ! adb get-state >/dev/null 2>&1; then
    echo "error: no phone in device mode in adb (check the cable/authorization)." >&2
    exit 1
fi

if ! ss -tln 2>/dev/null | grep -q "127.0.0.1:$PORT"; then
    echo "error: PipeWire is not listening on 127.0.0.1:$PORT." >&2
    echo "       check ~/.config/pipewire/pipewire.conf.d/21-phone-speaker.conf" >&2
    exit 1
fi

restore() {
    echo
    [ -n "$PREV" ] && [ "$PREV" != "$PHONE" ] || return 0
    echo "putting the audio back on $PREV..."
    pactl set-default-sink "$PREV" 2>/dev/null || true
    for i in $(pactl list short sink-inputs 2>/dev/null | cut -f1); do
        pactl move-sink-input "$i" "$PREV" 2>/dev/null || true
    done
    adb reverse --remove "tcp:$PORT" 2>/dev/null || true
}
trap restore EXIT INT TERM

# tunnel the port through the cable: phone's localhost -> PC's localhost
adb reverse "tcp:$PORT" "tcp:$PORT" >/dev/null

# send everything to the phone
pactl set-default-sink "$PHONE"
for i in $(pactl list short sink-inputs 2>/dev/null | cut -f1); do
    pactl move-sink-input "$i" "$PHONE" 2>/dev/null || true
done

echo "PC audio -> phone (port $PORT over USB)"
echo "open Simple Protocol Player on the phone: 127.0.0.1 : $PORT, 48000, 2ch, 16 bit"
echo "Ctrl-C to switch back."

# keep the script alive so the trap runs on Ctrl-C
while sleep 3600; do :; done
