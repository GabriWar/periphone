#!/usr/bin/env bash
# LEGACY alternative (no app needed): uses the phone mic as a PC mic via scrcpy.
# The audio lands on the virtual node "phone_mic" -> pick "Phone mic (USB)"
# as the input in the app you're using. Prefer phone-bridge.
#
# Usage:  phone-mic [buffer_ms] [source]
#   buffer_ms  default 40. Smaller = less delay, more risk of crackling.
#   source     default "mic" (measured: mean -31/-27 dB, max -10/-9 dB).
#              Alternatives: mic-voice-communication (echo cancelling/AGC),
#              mic-unprocessed, mic-camcorder, mic-voice-recognition
set -euo pipefail

BUF="${1:-40}"
SRC="${2:-mic}"

if ! adb get-state >/dev/null 2>&1; then
    echo "error: no phone in device mode in adb. Check the cable and the" >&2
    echo "       USB debugging authorization (adb devices)." >&2
    exit 1
fi

echo "phone mic -> phone_mic  (buffer ${BUF}ms, source ${SRC})"
echo "pick 'Phone mic (USB)' as the input. Ctrl-C to stop."

exec env PIPEWIRE_PROPS="{ target.object = phone_mic_in, node.name = phone-mic-bridge }" \
    scrcpy \
        --no-video \
        --no-window \
        --audio-source="$SRC" \
        --audio-buffer="$BUF"
