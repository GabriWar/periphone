#!/usr/bin/env bash
# Starts the USB Audio Bridge app on the phone and routes the PC's audio (and camera) through it.
#   output:      PC -> phone (-> headphones)    port 12345
#   mic:         phone -> PC                    port 12346
#   camera:      phone -> PC webcam             port 12347 (needs v4l2loopback + ffmpeg)
#   phone audio: phone's sound -> PC speakers   port 12348
#   Wi-Fi / Bluetooth: phone-relay on port 12350 (UDP + TCP) bridges the phone to the ports above
#
# Usage: phone-bridge [options]
#   Link (default: the USB cable):
#       --wifi              over Wi-Fi (phone and PC on the same network)
#       --pan [MAC]         over Bluetooth tethering (turn it on on the phone first; MAC = the
#                           phone's, to join it with nmcli; default: the only paired device)
#       --bt                over Bluetooth direct (RFCOMM; pair the phone with the PC first)
#       --codec auto|pcm|opus   audio codec on Wi-Fi/Bluetooth (auto = opus; pcm: no codec, clicks on loss)
#       --no-encrypt        don't encrypt Wi-Fi/Bluetooth streams (the PIN is still checked)
#   Streams:
#   -b, --buffer MS     output buffer 10..200 ms (default: what's saved in the app).
#                       Smaller = less delay, more risk of crackling.
#   -m, --mic-mode N    MediaRecorder.AudioSource id: 1=standard (default), 7=voice call
#                       (echo/noise cancelling), 9=raw, 6=voice recognition, 5=camcorder
#   -c, --cam [front|back]   also stream the phone camera as a webcam
#   -a, --phone-audio   also play the phone's own sound on the PC speakers (Android 10+;
#                       the phone asks for screen-capture permission)
#       --no-mic        don't send the phone mic
#       --no-out        don't play PC audio on the phone
#   phone-bridge stop                      stop a running bridge
#   phone-bridge pin [new]                 show (or change) the PIN for Wi-Fi/Bluetooth
#   phone-bridge ports <out> <mic> [cam]   change the ports (if the defaults are taken)
#
# The phone must be unlocked when starting (Android only gives the mic/camera to an app in
# the foreground). After that the screen can turn off.
# Without adb (Wi-Fi/Bluetooth with no cable or wireless debugging), open the app yourself,
# pick the link, type the PIN and tap Start.
# Ctrl-C (or 'phone-bridge stop') puts the audio back where it was and closes the app.
set -euo pipefail

PKG=dev.gabriwar.usbaudio
PIDFILE="${XDG_RUNTIME_DIR:-$HOME/.cache}/phone-bridge.pid"
CONF_DIR="$HOME/.config/pipewire/pipewire.conf.d"
SPK_CONF="$CONF_DIR/21-phone-speaker.conf"
MIC_CONF="$CONF_DIR/22-phone-mic-server.conf"
CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/phone-bridge"
CAM_PORT_FILE="$CFG_DIR/cam-port"
PIN_FILE="$CFG_DIR/pin"
AUDIO_PORT=12348
NET_PORT=12350
HERE="$(dirname "$(readlink -f "$0")")"

die() { echo "error: $*" >&2; exit 1; }
port_of() { grep -oP 'tcp:127\.0\.0\.1:\K[0-9]+' "$1" 2>/dev/null | head -1 || true; }
# capture first, then test: 'cmd | grep -q' can fail under pipefail when grep exits early
listening() { [ -n "$(ss -Htln "( sport = :$1 )" 2>/dev/null)" ]; }
ensure_pin() {
    if [ ! -s "$PIN_FILE" ]; then
        mkdir -p "$CFG_DIR"
        (umask 077; printf '%06d\n' $(( $(od -An -N4 -tu4 /dev/urandom) % 1000000 )) > "$PIN_FILE")
    fi
    PIN=$(tr -d '[:space:]' < "$PIN_FILE")
}

# ---------------------------------------------------------------- phone-bridge stop
# (the process is called "bash", pkill -x wouldn't find it)
if [ "${1:-}" = "stop" ]; then
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        kill "$(cat "$PIDFILE")" && echo "bridge stopped."
    else
        echo "no bridge running."
    fi
    exit 0
fi

# ---------------------------------------------------------------- phone-bridge pin
if [ "${1:-}" = "pin" ]; then
    [ "${2:-}" = new ] && : > "$PIN_FILE"
    ensure_pin
    echo "PIN: $PIN   (type it in the app: Connection > PIN)"
    exit 0
fi

# ---------------------------------------------------------------- phone-bridge ports
# The PipeWire configs are the source of truth for the audio ports.
if [ "${1:-}" = "ports" ]; then
    if [ $# -lt 3 ] || [ $# -gt 4 ]; then die "usage: phone-bridge ports <out_port> <mic_port> [cam_port]"; fi
    for p in "${@:2}"; do
        if ! [[ "$p" =~ ^[0-9]+$ ]] || [ "$p" -lt 1024 ] || [ "$p" -gt 65535 ]; then
            die "invalid port: $p (use 1024..65535)"
        fi
    done
    [ -f "$SPK_CONF" ] && [ -f "$MIC_CONF" ] || die "PipeWire configs not installed (run pc/install.sh)"
    cur_spk=$(port_of "$SPK_CONF"); cur_mic=$(port_of "$MIC_CONF")
    cur_cam=$(cat "$CAM_PORT_FILE" 2>/dev/null || echo 12347)
    new_cam="${4:-$cur_cam}"
    [ "$(printf '%s\n' "$2" "$3" "$new_cam" | sort -u | wc -l)" -eq 3 ] \
        || die "the ports must all be different (camera port: $new_cam)"
    for p in "$2" "$3" ${4:+"$4"}; do
        if [ "$p" != "$cur_spk" ] && [ "$p" != "$cur_mic" ] && [ "$p" != "$cur_cam" ] && listening "$p"; then
            echo "error: port $p is already in use:" >&2; ss -Htlnp "( sport = :$p )" >&2; exit 1
        fi
    done
    sed -i "s|tcp:127\.0\.0\.1:[0-9]*|tcp:127.0.0.1:$2|" "$SPK_CONF"
    sed -i "s|tcp:127\.0\.0\.1:[0-9]*|tcp:127.0.0.1:$3|" "$MIC_CONF"
    if [ -n "${4:-}" ]; then mkdir -p "$(dirname "$CAM_PORT_FILE")"; echo "$4" > "$CAM_PORT_FILE"; fi
    systemctl --user restart pipewire pipewire-pulse wireplumber
    echo "ports: output $2, mic $3${4:+, camera $4} (PipeWire restarted). Run phone-bridge again."
    echo "Set the same ports in the app if you changed them there (Advanced > Ports)."
    exit 0
fi

# ---------------------------------------------------------------- options
BUF=""; SRC=""; CAM=""; SPK=true; MIC=true; CAP=false
LINK=usb; PAN_MAC=""; CODEC=auto; ENCRYPT=true
while [ $# -gt 0 ]; do
    case "$1" in
        -b|--buffer)   [ $# -ge 2 ] || die "$1 needs a value"; BUF="$2"; shift ;;
        -m|--mic-mode) [ $# -ge 2 ] || die "$1 needs a value"; SRC="$2"; shift ;;
        -c|--cam|--camera)
            CAM=back
            if [ "${2:-}" = front ] || [ "${2:-}" = back ]; then CAM="$2"; shift; fi ;;
        -a|--phone-audio) CAP=true ;;
        --no-mic) MIC=false ;;
        --no-out) SPK=false ;;
        --wifi) LINK=wifi ;;
        --bt)   LINK=bt ;;
        --pan)
            LINK=pan
            if [[ "${2:-}" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]; then PAN_MAC="$2"; shift; fi ;;
        --codec)
            [ $# -ge 2 ] || die "$1 needs a value"
            case "$2" in auto|pcm|opus) CODEC="$2" ;; *) die "--codec: auto, pcm or opus" ;; esac
            shift ;;
        --no-encrypt) ENCRYPT=false ;;
        -h|--help) sed -n '2,/^[^#]/{/^#/p}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        [0-9]*)   # old style: phone-bridge [buffer_ms] [mic_mode]
            if [ -z "$BUF" ]; then BUF="$1"; else SRC="$1"; fi ;;
        *) die "unknown option: $1 (see phone-bridge --help)" ;;
    esac
    shift
done
if [ -n "$BUF" ] && { ! [[ "$BUF" =~ ^[0-9]+$ ]] || [ "$BUF" -lt 10 ] || [ "$BUF" -gt 200 ]; }; then
    die "buffer must be 10..200 ms"
fi
if [ -n "$SRC" ] && ! [[ "$SRC" =~ ^[0-9]+$ ]]; then die "mic mode must be a number (see --help)"; fi

# don't run two bridges at once
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    die "a bridge is already running (pid $(cat "$PIDFILE")). Use: phone-bridge stop"
fi

SPK_PORT=$(port_of "$SPK_CONF"); SPK_PORT=${SPK_PORT:-12345}
MIC_PORT=$(port_of "$MIC_CONF"); MIC_PORT=${MIC_PORT:-12346}
CAM_PORT=$(cat "$CAM_PORT_FILE" 2>/dev/null || true); CAM_PORT=${CAM_PORT:-12347}

# ---------------------------------------------------------------- checks
command -v pactl >/dev/null || die "pactl not found (install libpulse / pipewire-pulse)"
# adb: required for USB; for Wi-Fi/Bluetooth only used (if a phone is there) to start the app
ADB=false
adb_list=""; n_dev=0
if command -v adb >/dev/null; then
    adb_list=$(adb devices 2>/dev/null || true)
    n_dev=$(awk 'NR>1 && $2=="device"' <<<"$adb_list" | wc -l)
    if [ -n "${ANDROID_SERIAL:-}" ]; then
        adb get-state >/dev/null 2>&1 && ADB=true
    elif [ "$n_dev" -eq 1 ]; then
        ADB=true
    fi
fi
if [ "$LINK" = usb ]; then
    command -v adb >/dev/null || die "adb not found (install android-tools)"
    if [ "$n_dev" -eq 0 ]; then
        if grep -q unauthorized <<<"$adb_list"; then
            die "the phone hasn't authorized this PC yet: unlock it and accept the USB debugging prompt."
        fi
        die "no phone found by adb. Check the cable and that USB debugging is on (adb devices). Or use --wifi / --bt."
    fi
    if [ "$ADB" != true ]; then
        die "more than one device in adb; pick one with: ANDROID_SERIAL=<serial> phone-bridge (see adb devices)"
    fi
fi
if [ "$ADB" = true ]; then
    adb shell pm path "$PKG" >/dev/null 2>&1 \
        || die "app not installed. Build and install it: ./build.sh && adb install -r usb-audio-bridge.apk"
fi
for p in $SPK_PORT $MIC_PORT; do
    listening "$p" \
        || die "PipeWire isn't listening on 127.0.0.1:$p. Install the configs: pc/install.sh"
done

if [ "$LINK" != usb ]; then
    command -v python3 >/dev/null || die "python3 not found (needed for Wi-Fi/Bluetooth)"
    python3 -c 'import cryptography' 2>/dev/null \
        || die "Wi-Fi/Bluetooth needs python-cryptography (Arch: sudo pacman -S python-cryptography)"
    listening "$NET_PORT" && die "port $NET_PORT is taken (another phone-relay running?)"
    ensure_pin
fi
if [ "$LINK" = bt ] || [ "$LINK" = pan ]; then
    if [ "$LINK" = bt ]; then
        python3 -c 'import dbus, gi' 2>/dev/null \
            || die "Bluetooth direct needs python-dbus and python-gobject (Arch: sudo pacman -S python-dbus python-gobject)"
    fi
    if ! bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
        die "Bluetooth is off on the PC. Turn it on: rfkill unblock bluetooth && bluetoothctl power on"
    fi
fi

# camera receiver: available if there's a v4l2loopback device and ffmpeg
CAM_OK=false; CAM_WHY=""
if ! command -v ffmpeg >/dev/null; then CAM_WHY="ffmpeg not installed"
elif ! command -v python3 >/dev/null; then CAM_WHY="python3 not installed"
elif ! ls /sys/devices/virtual/video4linux/video* >/dev/null 2>&1; then
    CAM_WHY="v4l2loopback not loaded: sudo modprobe v4l2loopback exclusive_caps=1 card_label=\"Phone Camera\""
elif [ "$LINK" = bt ]; then CAM_WHY="not over Bluetooth direct (too little bandwidth)"
else CAM_OK=true; fi
if [ -n "$CAM" ] && [ "$CAM_OK" != true ]; then die "camera unavailable: $CAM_WHY"; fi

echo $$ > "$PIDFILE"

# ---------------------------------------------------------------- routing helpers
sink_idx() { pactl list short sinks | awk -v n="$1" '$2==n {print $1}'; }
# the phone's sound comes in as a "127.0.0.1 playback" stream: it must stay on the real speakers
phone_audio_inputs() {
    pactl list sink-inputs 2>/dev/null | awk '/^Sink Input #/{id=substr($3,2)} /media.name = "127.0.0.1 playback"/{print id}'
}
move_inputs() {   # move_inputs <from_sink> <to_sink>: only what's on the source sink
    local from to skip; from=$(sink_idx "$1"); to="$2"
    [ -n "$from" ] || return 0
    skip=" $(phone_audio_inputs | tr '\n' ' ') "
    pactl list short sink-inputs | awk -v f="$from" '$2==f {print $1}' | while read -r id; do
        [[ "$skip" == *" $id "* ]] && continue
        pactl move-sink-input "$id" "$to" 2>/dev/null || true
    done
}

# remember where the audio was, to put it back on exit
PREV_SINK=$(pactl get-default-sink 2>/dev/null || true)
PREV_SOURCE=$(pactl get-default-source 2>/dev/null || true)
[ "$PREV_SINK" = phone_speaker ] && PREV_SINK=""
[ "$PREV_SOURCE" = phone_mic ] && PREV_SOURCE=""
# where the phone's own sound plays: the real speakers, never the phone (that would loop)
AUDIO_SINK=${PREV_SINK:-$(pactl list short sinks | awk '$2!="phone_speaker" && $2!="phone_mic_in" {print $2; exit}')}
CAM_PID=""; RELAY_PID=""; AUDIO_MOD=""

restore() {
    set +e   # best effort: one failing step must not skip the rest of the cleanup
    echo
    echo "putting the audio back${PREV_SINK:+ on $PREV_SINK} and closing the app..."
    [ -n "$CAM_PID" ] && kill "$CAM_PID" 2>/dev/null || true
    [ -n "$RELAY_PID" ] && kill "$RELAY_PID" 2>/dev/null || true
    [ -n "$AUDIO_MOD" ] && pactl unload-module "$AUDIO_MOD" 2>/dev/null || true
    if [ -n "$PREV_SINK" ]; then
        pactl set-default-sink "$PREV_SINK" 2>/dev/null || true
        move_inputs phone_speaker "$PREV_SINK"
    fi
    [ -n "$PREV_SOURCE" ] && pactl set-default-source "$PREV_SOURCE" 2>/dev/null || true
    if [ "$ADB" = true ]; then
        adb shell am force-stop "$PKG" 2>/dev/null || true
        if [ "$LINK" = usb ]; then
            for p in $SPK_PORT $MIC_PORT $CAM_PORT $AUDIO_PORT; do adb reverse --remove "tcp:$p" 2>/dev/null || true; done
        fi
    fi
}
trap 'rm -f "$PIDFILE"; restore' EXIT
trap 'exit 0' INT TERM      # without this, TERM would restore and the script would keep going

# ---------------------------------------------------------------- start
if [ "$ADB" = true ]; then
    # the old player app would also connect to 12345 and double the stream
    adb shell am force-stop com.kaytat.simpleprotocolplayer 2>/dev/null || true
    adb shell am force-stop "$PKG" 2>/dev/null || true
fi

if [ "$CAM_OK" = true ]; then
    "$HERE/phone-cam" --port "$CAM_PORT" &
    CAM_PID=$!
fi

# phone's sound -> PC speakers: a loopback-only TCP server straight into the real speakers
if [ -n "$AUDIO_SINK" ]; then
    AUDIO_MOD=$(pactl load-module module-simple-protocol-tcp rate=48000 format=s16le channels=2 \
        playback=true record=false sink="$AUDIO_SINK" port="$AUDIO_PORT" listen=127.0.0.1 2>/dev/null || true)
    [ -n "$AUDIO_MOD" ] || echo "warning: couldn't listen on 127.0.0.1:$AUDIO_PORT (phone audio -> PC unavailable)"
fi

PC_HOST=""; BT_ADDR=""
case "$LINK" in
    wifi|pan)
        if [ "$LINK" = pan ]; then
            if [ -z "$PAN_MAC" ]; then
                paired=$(bluetoothctl devices Paired 2>/dev/null | awk '{print $2}')
                [ "$(wc -w <<<"$paired")" -eq 1 ] && PAN_MAC="$paired"
            fi
            if [ -n "$PAN_MAC" ] && command -v nmcli >/dev/null; then
                echo "joining the phone's Bluetooth tethering ($PAN_MAC)..."
                nmcli device connect "$PAN_MAC" >/dev/null 2>&1 \
                    || echo "  couldn't join it: turn on Bluetooth tethering on the phone (Settings > Hotspot & tethering)"
            else
                echo "join the phone's Bluetooth tethering: nmcli device connect <phone MAC> (see: bluetoothctl devices)"
            fi
        else
            # Wi-Fi power saving parks the radio between beacons: tens of ms of extra jitter
            for w in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do
                if iw dev "$w" get power_save 2>/dev/null | grep -q ': on'; then
                    echo "tip: $w has power saving on (adds jitter): sudo iw dev $w set power_save off"
                fi
                # 2.4 GHz: crowded, slow, 100+ ms spikes and loss; 5 GHz on both ends is clean
                f=$(iw dev "$w" link 2>/dev/null | awk '/freq:/{print int($2)}')
                if [ -n "$f" ] && [ "$f" -lt 3000 ]; then
                    echo "warning: the PC's Wi-Fi ($w) is on 2.4 GHz: expect dropouts and extra delay; use 5 GHz"
                fi
            done
            if [ "$ADB" = true ]; then
                f=$(adb shell dumpsys wifi 2>/dev/null | grep -m1 -oE 'Frequency: [0-9]+' | grep -oE '[0-9]+' || true)
                if [ -n "$f" ] && [ "$f" -lt 3000 ]; then
                    echo "warning: the phone's Wi-Fi is on 2.4 GHz: expect dropouts and extra delay; use 5 GHz"
                fi
            fi
            # with wireless debugging we know where the phone is: give it our address on that network
            if [ "$ADB" = true ]; then
                phone_ip=$(adb shell ip -4 -o addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1 || true)
                [ -n "$phone_ip" ] && PC_HOST=$(ip -4 route get "$phone_ip" 2>/dev/null | grep -oP 'src \K[0-9.]+' || true)
            fi
        fi
        if systemctl is-active -q ufw 2>/dev/null || systemctl is-active -q firewalld 2>/dev/null; then
            echo "note: a firewall is on; the phone needs port $NET_PORT (UDP and TCP), e.g.:"
            echo "      sudo ufw allow $NET_PORT    or    sudo firewall-cmd --add-port=$NET_PORT/udp --add-port=$NET_PORT/tcp"
        fi
        relay_args=(--port "$NET_PORT" --label "$([ "$LINK" = pan ] && echo bt-tether || echo wifi)") ;;
    bt)
        BT_ADDR=$(bluetoothctl show 2>/dev/null | awk '/^Controller/{print $2; exit}')
        relay_args=(--bt --no-net) ;;
esac
if [ "$LINK" != usb ]; then
    "$HERE/phone-relay" "${relay_args[@]}" --pin-file "$PIN_FILE" --spk-port "$SPK_PORT" \
        --mic-port "$MIC_PORT" --cam-port "$CAM_PORT" --audio-port "$AUDIO_PORT" &
    RELAY_PID=$!
fi

if [ "$ADB" = true ]; then
    if [ "$LINK" = usb ]; then
        adb reverse "tcp:$SPK_PORT" "tcp:$SPK_PORT" >/dev/null
        adb reverse "tcp:$MIC_PORT" "tcp:$MIC_PORT" >/dev/null
        adb reverse "tcp:$AUDIO_PORT" "tcp:$AUDIO_PORT" >/dev/null
        [ "$CAM_OK" = true ] && adb reverse "tcp:$CAM_PORT" "tcp:$CAM_PORT" >/dev/null
    fi
    for perm in RECORD_AUDIO CAMERA POST_NOTIFICATIONS BLUETOOTH_CONNECT; do
        adb shell pm grant "$PKG" "android.permission.$perm" 2>/dev/null || true
    done
    # keep it alive in the background: no battery optimization, no background restriction,
    # most active standby bucket (Xiaomi & co. still have their own switch: see the app's Advanced)
    adb shell dumpsys deviceidle whitelist "+$PKG" >/dev/null 2>&1 || true
    adb shell cmd appops set "$PKG" RUN_ANY_IN_BACKGROUND allow 2>/dev/null || true
    adb shell am set-standby-bucket "$PKG" active 2>/dev/null || true
    # lets the phone-audio capture start without the screen-capture prompt (where Android honors it)
    [ "$CAP" = true ] && adb shell appops set "$PKG" PROJECT_MEDIA allow 2>/dev/null || true
    adb shell input keyevent KEYCODE_WAKEUP 2>/dev/null || true

    link_id=$(case $LINK in usb) echo 0 ;; wifi) echo 1 ;; pan) echo 2 ;; bt) echo 3 ;; esac)
    codec_id=$(case $CODEC in auto) echo 0 ;; pcm) echo 1 ;; opus) echo 2 ;; esac)
    extras=(--ez autostart true --ez spk "$SPK" --ez mic "$MIC" --ez cap "$CAP"
            --ei spkport "$SPK_PORT" --ei micport "$MIC_PORT" --ei camport "$CAM_PORT"
            --ei link "$link_id")
    if [ "$LINK" != usb ]; then
        extras+=(--es pin "$PIN" --ez encrypt "$ENCRYPT" --ei codec "$codec_id")
        [ "$LINK" = wifi ] && extras+=(--es host "$PC_HOST")
        [ -n "$BT_ADDR" ] && extras+=(--es btaddr "$BT_ADDR")
    fi
    [ -n "$BUF" ] && extras+=(--ei buf "$BUF")
    [ -n "$SRC" ] && extras+=(--ei src "$SRC")
    if [ -n "$CAM" ]; then
        extras+=(--ez cam true --ez camfront "$([ "$CAM" = front ] && echo true || echo false)")
    fi
    adb shell am start -n "$PKG/.Autostart" "${extras[@]}" >/dev/null
else
    echo
    echo "On the phone: open USB Audio Bridge, Connection > $(case $LINK in wifi) echo Wi-Fi ;; pan) echo 'BT net' ;; bt) echo "BT direct (pick this PC)" ;; esac),"
    echo "PIN $PIN, then tap Start."
fi

conns() { ss -Htn state established "( sport = :$1 )" 2>/dev/null | wc -l; }
echo "waiting for the app to connect..."
spk=0; mic=0
tries=$([ "$ADB" = true ] && echo 30 || echo 120)
for _ in $(seq 1 "$tries"); do
    spk=$(conns "$SPK_PORT"); mic=$(conns "$MIC_PORT")
    { [ "$SPK" = false ] || [ "$spk" -gt 0 ]; } && { [ "$MIC" = false ] || [ "$mic" -gt 0 ]; } && break
    sleep 0.5
done
if [ "$SPK" = true ]; then
    [ "$spk" -gt 0 ] && echo "  output: CONNECTED" || echo "  output: not connected (is the phone unlocked?)"
fi
if [ "$MIC" = true ]; then
    [ "$mic" -gt 0 ] && echo "  mic:    CONNECTED" || echo "  mic:    not connected (mic permission?)"
fi
if [ "$CAM_OK" = true ]; then
    echo "  camera: receiver ready (turn the camera on in the app${CAM:+; starting the $CAM camera})"
else
    echo "  camera: unavailable ($CAM_WHY)"
fi
[ "$CAP" = true ] && echo "  phone audio: accept the screen-capture prompt on the phone if it shows up"

if [ "$SPK" = true ]; then
    pactl set-default-sink phone_speaker
    [ -n "$PREV_SINK" ] && move_inputs "$PREV_SINK" phone_speaker
fi
[ "$MIC" = true ] && pactl set-default-source phone_mic

echo
echo "PC audio -> phone, phone mic -> PC over $LINK   (buffer: ${BUF:-from the app}, mic mode: ${SRC:-from the app})"
[ "$LINK" != usb ] && echo "PIN: $PIN   (phone-bridge pin new: change it)"
echo "in apps/games pick the input 'Phone mic (USB)'$([ "$CAM_OK" = true ] && echo " and the camera on $(ls /sys/devices/virtual/video4linux | head -1 | sed 's|^|/dev/|')"). Ctrl-C to stop."

# keep watching: report when something drops or comes back
last=""
while sleep 2; do
    now="output=$([ "$(conns "$SPK_PORT")" -gt 0 ] && echo on || echo OFF)"
    now+=" mic=$([ "$(conns "$MIC_PORT")" -gt 0 ] && echo on || echo OFF)"
    [ "$CAM_OK" = true ] && now+=" camera=$([ "$(conns "$CAM_PORT")" -gt 0 ] && echo on || echo off)"
    [ -n "$AUDIO_MOD" ] && now+=" phone-audio=$([ "$(conns "$AUDIO_PORT")" -gt 0 ] && echo on || echo off)"
    if [ -n "$CAM_PID" ] && ! kill -0 "$CAM_PID" 2>/dev/null; then
        echo "[$(date +%H:%M:%S)] the camera receiver stopped"; CAM_PID=""
    fi
    if [ -n "$RELAY_PID" ] && ! kill -0 "$RELAY_PID" 2>/dev/null; then
        echo "[$(date +%H:%M:%S)] phone-relay stopped: Wi-Fi/Bluetooth streams are down"; RELAY_PID=""
    fi
    # keep the phone's sound on the speakers even if something moved it to the phone
    if [ -n "$AUDIO_MOD" ]; then
        to=$(sink_idx "$AUDIO_SINK")
        for id in $(phone_audio_inputs); do
            on=$(pactl list short sink-inputs | awk -v i="$id" '$1==i {print $2}')
            [ -n "$on" ] && [ -n "$to" ] && [ "$on" != "$to" ] && [ "$on" = "$(sink_idx phone_speaker)" ] \
                && pactl move-sink-input "$id" "$AUDIO_SINK" 2>/dev/null || true
        done
    fi
    if [ "$LINK" = usb ] && ! adb get-state >/dev/null 2>&1; then now="phone disconnected (cable?)"; fi
    [ "$now" != "$last" ] && { echo "[$(date +%H:%M:%S)] $now"; last="$now"; }
done
